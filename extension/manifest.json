{
  "manifest_version": 3,
  "name": "Password Generator – lokal & sicher",
  "version": "1.0.0",
  "description": "Starke Passwörter direkt in Chrome erstellen. Lokal, ohne Konto und ohne Verlauf.",
  "permissions": [
    "clipboardWrite"
  ],
  "action": {
    "default_title": "Passwort erstellen",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "key": ""
}
